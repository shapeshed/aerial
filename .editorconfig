# Editor and formatting conventions for Aerial.
# https://editorconfig.org
#
# This is the shared baseline for IDEs and any future formatter/linter
# integration. It does not change build behavior on its own.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# ktlint reads these. Compose/Screenshot preview functions intentionally use
# PascalCase, so do not flag functions annotated with these as naming violations.
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview, PreviewTest

[*.{gradle,toml}]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.xml]
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
