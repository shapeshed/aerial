<?xml version="1.0" encoding="utf-8"?>
<!--
  Aerial stores favourites, play history, settings, and downloaded artwork locally, and ships
  its own Export/Import backup (Settings -> Data) as a user-controlled file. Platform backup is
  deliberately off, so both cloud backup and device-to-device transfer exclude everything.

  `android:allowBackup="false"` alone is not sufficient from Android 12 onwards: it does not fully
  govern device-to-device transfer on every OEM build, so the intent is stated explicitly here as
  well. lint's DataExtractionRules check is what surfaced the gap.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
