{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    ":rebaseStalePrs",
    ":prConcurrentLimit10",
    ":automergeRequireAllStatusChecks"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "major": {
    "automerge": false
  },
  "enabledManagers": [
    "gradle",
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pin the F-Droid buildserver image used by the release workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "registry\\.gitlab\\.com/fdroid/fdroidserver:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "depNameTemplate": "registry.gitlab.com/fdroid/fdroidserver",
      "datasourceTemplate": "docker"
    }
  ],
  "timezone": "UTC",
  "dependencyDashboard": true
}
